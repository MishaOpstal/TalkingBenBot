# Copy this file to .env and fill in DISCORD_TOKEN. Everything else is optional.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Speech model used to hear "Ben". Downloaded automatically the first time (about 40 MB).
#   nl = Dutch model (best if you speak Dutch, or English with a Dutch accent)
#   en = English model
#   or the path to a Vosk model folder you downloaded yourself
SPEECH_MODEL=nl

# Optional: your test server's ID. Slash command changes show up there instantly
# instead of after a minute or so. Leave empty when running for real.
DEV_GUILD_ID=

# DEBUG shows more detail, WARNING shows less.
LOG_LEVEL=INFO
